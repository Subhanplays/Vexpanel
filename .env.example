# Application
APP_NAME=VexPanel
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=generate-a-secure-random-string-at-least-32-chars

# Database
DATABASE_URL=postgresql://vexpanel:change_me@localhost:5432/vexpanel

# Redis
REDIS_URL=redis://localhost:6379/0

# VPS Provider
VPS_PROVIDER=custom

# Tunnel Providers
TRYCLOUDFLARE_ENABLED=true
PINGGY_ENABLED=true
PINGGY_TOKEN=

# SMTP (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=noreply@vexpanel.example.com

# VPS Defaults
MAX_VPS_PER_USER=3
DEFAULT_OS_IMAGE=ubuntu:22.04
DOCKER_NETWORK=vexpanel_network
VPS_HOSTNAME_PREFIX=vex-

# RDP Configuration
RDP_DOCKER_IMAGE=akarita/docker-ubuntu-desktop
RDP_INTERNAL_PORT=6080
RDP_CONTAINER_PREFIX=vexpanel-rdp-